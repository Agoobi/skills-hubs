{
  "source": "Measured from Metics Media frames, October 2026. Colours are 7x7 pixel averages from compressed video, so expect a few units of error.",
  "formats": {
    "short": { "width": 1080, "height": 1920, "fps": 30, "seconds": [25, 60], "safe": { "top": 220, "bottom": 420, "side": 72 }, "type_scale": 1.25 },
    "long": { "width": 1920, "height": 1080, "fps": 30, "seconds": [180, 1500], "safe": { "top": 96, "bottom": 96, "side": 96 }, "type_scale": 1 }
  },
  "color": {
    "note": "Reference palette for a coral accent. Derive the palette for another brand with: video.py theme --accent <hex>",
    "canvas": "#FAF9F5",
    "canvas-glow": "#F4D2C6",
    "card": "#FDFCF8",
    "card-tile": "#EFE8E0",
    "ink": "#1C1917",
    "ink-soft": "#6A6360",
    "accent": "#E77B58",
    "accent-soft": "#E69F87",
    "chapter-bg": "#1A110C",
    "chapter-glow": "#A5553A",
    "chapter-numeral": "#2A1A13",
    "chapter-label": "#B28C7F",
    "chapter-title": "#FEFCFB",
    "chapter-title-dim": "#705042",
    "screen-bg": "#141414"
  },
  "type": {
    "family": "Inter Tight",
    "fallback": "Inter, system-ui, sans-serif",
    "chapter-title": { "size": 96, "weight": 800, "tracking": "-0.04em" },
    "chapter-label": { "size": 34, "weight": 500, "tracking": "-0.01em" },
    "chapter-numeral": { "size": 900, "weight": 800, "tracking": "-0.06em" },
    "card-title": { "size": 44, "weight": 700, "tracking": "-0.03em" },
    "card-figure": { "size": 34, "weight": 600, "tracking": "-0.02em" },
    "stat-pill": { "size": 40, "weight": 700, "tracking": "-0.02em" },
    "url-pill": { "size": 34, "weight": 700, "tracking": "-0.02em" },
    "caption-long": { "size": 40, "weight": 500, "tracking": "0" },
    "caption-short": { "size": 64, "weight": 800, "tracking": "-0.01em" }
  },
  "shape": {
    "card-radius": 24,
    "tile-radius": 12,
    "browser-radius": 18,
    "card-shadow": "0 2px 4px rgba(28,25,23,.04), 0 24px 60px -24px rgba(28,25,23,.22)",
    "browser-shadow": "0 40px 90px -40px rgba(28,25,23,.35)"
  },
  "motion": {
    "enter": { "y": 24, "duration": 0.45, "ease": "power3.out" },
    "stagger": [0.08, 0.12],
    "card-pop": { "from_scale": 0.94, "duration": 0.5, "ease": "power3.out" },
    "receipt-row-gap": 0.35,
    "url-pill": { "in": 0.4, "hold": [2.5, 3.0], "out": 0.3 },
    "zoom": { "scale": [1.35, 1.6], "in": 0.6, "out": 0.5, "ease": "power2.inOut" },
    "cursor-scale": [1.8, 2.0],
    "chapter": { "hold": [2.5, 3.0], "numeral-drift-y": 40, "label-lead": 0.15 },
    "entrances": {
      "note": "Named entrance kinds for storyboard.md. Never use the same kind on two consecutive scenes.",
      "rise": { "y": 24, "duration": 0.45, "ease": "power3.out" },
      "grow": { "from_scale": 0.94, "duration": 0.5, "ease": "power3.out" },
      "punch": { "from_scale": 1.12, "duration": 0.28, "ease": "power4.out" },
      "swipe": { "x": 80, "duration": 0.4, "ease": "power3.out" },
      "drop": { "y": -60, "duration": 0.4, "ease": "power2.in" },
      "unfold": { "clip": "inset", "duration": 0.5, "ease": "power2.inOut" },
      "peel": { "clip": "diagonal", "duration": 0.55, "ease": "power2.inOut" },
      "draw": { "duration": [0.5, 0.8], "ease": "power1.inOut" },
      "count": { "duration": [0.6, 1.2], "ease": "power2.out" },
      "zoom-through": { "to_scale": 1.8, "duration": 0.35, "ease": "power2.in", "max_per_video": 2 }
    },
    "idle": { "drift-y": [4, 6], "breathe-scale": 1.015, "period": [4, 6], "ease": "sine.inOut" },
    "punch-phrase": { "words": [2, 5], "per_scene": 1 }
  },
  "pacing": {
    "long": { "hook_cut": [2, 3], "proof_shot": [5, 8], "explainer": [6, 12], "max_static": 8, "screen_change_every": [8, 15] },
    "short": { "hook_cut": [0.8, 1.5], "proof_shot": [2, 3], "explainer": [2, 4], "max_static": 2.5, "screen_shot": [3, 6] }
  },
  "audio": {
    "voice_lufs": { "long": -16, "short": -14 },
    "true_peak_db": -1,
    "music_under_voice_db": [18, 22],
    "scene_gap": { "long": [0.25, 0.4], "short": [0.1, 0.2] },
    "sfx_under_voice_db": [12, 16]
  }
}
