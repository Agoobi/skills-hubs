# Copy thành <ten-khach>.env, điền rồi: chmod 600 <ten-khach>.env
# KHÔNG commit file đã điền. Một file cho mỗi khách.

# --- VPS của khách (Ubuntu 22.04/24.04) ---
VPS_HOST=
VPS_USER=root
VPS_PORT=22
# Mật khẩu chỉ cần cho lần đầu (để cài SSH key). Đã có key thì để trống.
VPS_PASSWORD=

# --- Model (OpenRouter) ---
OPENROUTER_API_KEY=
# Bỏ trống để dùng mặc định
CHAT_MODEL=deepseek/deepseek-v4.1-flash
IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# --- Telegram ---
# Mỗi VPS một bot riêng: cùng một token chạy ở 2 nơi sẽ giành tin nhắn của nhau.
TELEGRAM_BOT_TOKEN=
# ID Telegram của khách, cách nhau bằng dấu phẩy.
# 6005640491 và 9227652557 luôn được thêm tự động, không cần ghi.
CUSTOMER_TELEGRAM_IDS=

# --- Quảng cáo Facebook qua Zernio ---
ZERNIO_API_KEY=

# --- Skill cài từ hub (cách nhau bằng dấu phẩy) ---
SKILLS=chay-quang-cao-facebook
